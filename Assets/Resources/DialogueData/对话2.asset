  - id: 1004
    nodeType: 0
    SpeakerName: "\u7BA1\u5BB6"
    Content: "\u8FD9\u4E2A\u5BB6\u65CF\u66FE\u4E16\u4EE3\u4F4F\u5728\u8FD9\u4E2A\u522B\u5885\u91CC\u3002\u4ED6\u4EEC\u4E0D\u4EC5\u4EE5\u663E\u8D6B\u7684\u5730\u4F4D\u95FB\u540D\uFF0C\u66F4\u56E0\u5BF9\u827A\u672F\u7684\u70ED\u7231\u800C\u5E7F\u4E3A\u4EBA\u77E5\u3002"
    nextNode: 1005
    OptionNodes: []
  - id: 1005
    nodeType: 0
    SpeakerName: "\u7BA1\u5BB6"
    Content: "\u4ED6\u4EEC\u4E16\u4EE3\u6536\u85CF\u4E86\u4F17\u591A\u827A\u672F\u73CD\u54C1\uFF0C\u4ECE\u53E4\u5178\u6CB9\u753B\u5230\u96D5\u5851\uFF0C\u4ECE\u73CD\u8D35\u624B\u7A3F\u5230\u53E4\u8463\u5668\u7269\uFF0C\u6BCF\u4E00\u4EF6\u90FD\u627F\u8F7D\u7740\u5386\u53F2\u4E0E\u6587\u5316\u7684\u539A\u91CD\u3002"
    nextNode: 1006
    OptionNodes: []
  - id: 1006
    nodeType: 0
    SpeakerName: "\u7BA1\u5BB6"
    Content: "\u8BB8\u591A\u5947\u602A\u7684\u90FD\u5E02\u4F20\u95FB\u4E5F\u5728\u8FD9\u5C06\u8FD1\u4E00\u767E\u5E74\u7684\u65F6\u95F4\u91CC\u7B3C\u7F69\u5728\u8FD9\u4E2A\u795E\u79D8\u7684\u5BB6\u65CF\u8EAB\u4E0A\u3002"
    nextNode: 1003
    OptionNodes: []
  - id: 1007
    nodeType: 0
    SpeakerName: "\u7BA1\u5BB6"
    Content: "\u4F60\u8BF4\u7684\u90A3\u4EF6\u96D5\u5851\u5E76\u4E0D\u5728\u53C2\u5C55\u7684\u8303\u56F4\u5185\u3002"
    nextNode: 1003
    OptionNodes: []
  - id: 1008
    nodeType: 0
    SpeakerName: "\u7BA1\u5BB6"
    Content: "\u6D1B\u592B\u83B1\u65AF\u5BB6\u65CF\u7684\u6536\u85CF\uFF0C\u5982\u540C\u5386\u53F2\u672C\u8EAB\uFF0C\u603B\u6709\u4E9B\u89D2\u843D\u7B3C\u7F69\u5728\u4E0D\u4E3A\u4EBA\u77E5\u7684\u8584\u96FE\u4E4B\u4E2D\u3002"
    nextNode: 1009
    OptionNodes: []
  - id: 1009
    nodeType: 0
    SpeakerName: "\u7BA1\u5BB6"
    Content: "?\u6709\u65F6\uFF0C\u4FDD\u7559\u4E00\u4E1D\u9050\u60F3\u7684\u7A7A\u95F4\uFF0C\u6216\u8BB8\u6BD4\u8D64\u88F8\u88F8\u7684\u771F\u76F8\u66F4\u5177\u2026\u827A\u672F\u4EF7\u503C\u3002\u60A8\u8BF4\u5462\uFF1F\u5475\u5475\u3002\u6055\u6211\u5931\u966A\uFF0C\u8FD8\u6709\u5176\u4ED6\u4E8B\u52A1\u9700\u8981\u5904\u7406\uFF0C\u8FD8\u8BF7\u60A8\u6162\u6162\u6B23\u8D4F\u3002"
