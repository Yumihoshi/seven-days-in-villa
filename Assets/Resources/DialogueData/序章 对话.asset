  m_Script: {fileID: 11500000, guid: 44841687c265240418dfd8cab99595d6, type: 3}
  m_Name: "\u5E8F\u7AE0 \u5BF9\u8BDD"
  m_EditorClassIdentifier: 
  dialogueName: "\u5E8F\u7AE0 \u5BF9\u8BDD"
  nodes:
  - id: 1000
    nodeType: 0
    SpeakerName: "\u83AB\u6559\u6388"
    Content: "\u770B\u8FD9\u4E2A\u3002\u4E4B\u524D\u6574\u7406\u65E7\u6863\u6848\u7FFB\u51FA\u6765\u7684\uFF0C\u4E5D\u5341\u5E74\u524D\u7684\u73A9\u610F\u513F\u4E86\u3002"
    nextNode: 1001
    OptionNodes: []
  - id: 1001
    nodeType: 0
    SpeakerName: "\u83AB\u6559\u6388"
    Content: "\u8FD9\u4E2A\u522B\u5885\u4E0B\u5468\u91CD\u65B0\u5F00\u653E\u90E8\u5206\u533A\u57DF\uFF0C\u542C\u8BF4\u8FD9\u4EF6\u96D5\u50CF\u4F1A\u4E5F\u5C55\u51FA\u3002\u5F53\u5E74\u62CD\u4E0B\u8FD9\u7167\u7247\u7684\u5BB6\u4F19\u662F\u4E2A\u4E0D\u592A\u5B88\u89C4\u77E9\u7684\u540C\u884C\u3002\u62CD\u5B8C\u6CA1\u591A\u4E45\u5C31\u2026\u5509\uFF0C\u610F\u5916\u79BB\u4E16\u4E86\u3002\u4ED6\u7559\u4E0B\u7684\u4E1C\u897F\u4E0D\u591A\uFF0C\u8FD9\u5F20\u7167\u7247\u7B97\u662F\u6700\u795E\u79D8\u7684\uFF0C\u6CA1\u4EBA\u77E5\u9053\u53D1\u751F\u4E86\u4EC0\u4E48\u8BA9\u4ED6\u8FD9\u4E48\u614C\u5F20\u5730\u62CD\u4E0B\u5B83\u3002"
    nextNode: 1002
    OptionNodes: []
  - id: 1002
    nodeType: 0
    SpeakerName: "\u83AB\u6559\u6388"
    Content: "\u6211\u6536\u5230\u4E86\u4ED6\u4EEC\u7684\u9080\u8BF7\u51FD\u3002\u4F46\u8FD9\u628A\u8001\u9AA8\u5934\u7ECF\u4E0D\u8D77\u6298\u817E\u4E86\uFF0C\u8FD9\u79CD\u4E8B\u8FD8\u662F\u4EA4\u7ED9\u4F60\u4EEC\u5E74\u8F7B\u4EBA\u6BD4\u8F83\u597D\u3002\u90A3\u4EF6\u96D5\u5851\u2026\u8FD8\u6709\u6574\u4E2A\u522B\u5885\u7684\u6536\u85CF\uFF0C\u90FD\u5145\u6EE1\u4E86\u72EC\u7279\u7684\u201C\u90FD\u5E02\u4F20\u8BF4\u201D\u8272\u5F69\uFF0C\u4F60\u4F1A\u611F\u5174\u8DA3\u7684\u3002\u522B\u5FD8\u4E86\u8BB0\u5F55\u4E0B\u4F60\u7684\u53D1\u73B0\u3002"
    nextNode: 1003
    OptionNodes: []
  - id: 1003
    nodeType: 0
    SpeakerName: "\u83AB\u6559\u6388"
    Content: "\u5BF9\u4E86\u3002\u5E84\u56ED\u73B0\u5728\u7684\u7BA1\u5BB6\uFF0C\u8001\u4F26\u7EB3\u5FB7\uFF0C\u636E\u8BF4\u4ED6\u7956\u7236\u90A3\u8F88\u5C31\u5728\u90A3\u513F\u4E86\u3002\_\u5E84\u56ED\u91CC\u91CC\u5916\u5916\u7684\u4E8B\u513F\uFF0C\u4ED6\u90FD\u77E5\u9053\u3002"
    nextNode: 1004
    OptionNodes: []
  - id: 1004
    nodeType: 0
    SpeakerName: "\u83AB\u6559\u6388"
    Content: "\u5982\u679C\u4F60\u60F3\u4E86\u89E3\u70B9\u85CF\u54C1\u7684\u2018\u5E55\u540E\u6545\u4E8B\u2019\uFF0C\u6216\u8BB8\u53EF\u4EE5\u8BD5\u7740\u627E\u4ED6\u804A\u804A\u3002\u4E0D\u8FC7\uFF0C\u8FD9\u79CD\u8001\u6D3E\u4EBA\uFF0C\u813E\u6C14\u96BE\u6349\u6478\u5F97\u5F88\u3002"
    nextNode: 1005
    OptionNodes: []
  - id: 1005
    nodeType: 1
    SpeakerName: null
    Content: "\u7ED3\u675F\u5BF9\u8BDD"
    nextNode: null
